# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Configuration (Agnostique)
DEFAULT_AI_PROVIDER=gemini # Options: gemini | openai | mock
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Google Calendar OAuth (Foyer Sync)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Configuration (Facturation dégressive foyer)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# MicroKanban Feedback Integration
MICROKANBAN_API_SECRET=your-microkanban-api-secret
MICROKANBAN_API_URL=https://jira-like.vercel.app/api/webhooks/external-feedback

# Google Search Console API (SEO Monitoring & Indexation)
# Path to downloaded service account JSON key (or inline JSON in GSC_SERVICE_ACCOUNT_JSON)
GSC_SERVICE_ACCOUNT_KEY_PATH=./gsc-credentials.json
# Search Console Property: e.g. sc-domain:lavigieauto.com or https://lavigieauto.com/
GSC_SITE_URL=sc-domain:lavigieauto.com

